# ============================================
# Desktop God Agent - 环境变量配置模板
# 复制此文件为 .env 并填入真实密钥
# ============================================

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

# ---- Google AI (Gemini) 视觉模型 ----
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL=gemini-2.0-flash

# ---- Ollama 本地模型 ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# ---- GitHub ----
GITHUB_TOKEN=ghp-your-github-token
GITHUB_REPO=yumengyu666/desktop-god-agent

# ---- 感知系统 ----
SCREEN_CAPTURE_INTERVAL_MS=100
UIA_SCAN_INTERVAL_MS=500
OCR_ENGINE=paddleocr

# ---- 执行引擎 ----
MOUSE_MOVE_DURATION_MS=300
KEYBOARD_TYPE_DELAY_MS=50
ACTION_VERIFY_TIMEOUT_MS=3000

# ---- 安全控制 ----
EMERGENCY_STOP_KEY=ctrl+alt+shift+q
AUDIT_LOG_DIR=./logs/audit
MAX_ACTIONS_PER_TASK=100

# ---- 记忆系统 ----
MEMORY_DB_PATH=./data/memory.db
MEMORY_PROMOTION_THRESHOLD=3

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs
